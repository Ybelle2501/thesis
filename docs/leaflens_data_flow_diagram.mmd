%% Repeated stores in the SVG use the same IDs here.
flowchart LR
    U["E1 App user / farm scout"]
    F["E3 OS file services"]
    B["E4 External browser"]
    C["E2 Camera / gallery"]
    subgraph APP["LeafLens application"]
    D1[("D1 Local persisted data: SQLite tables and saved images")]
    D2[("D2 Three-stage inference assets")]
    D3[("D3 Bundled crop guidance and station normals")]
    D4[("D4 Forecast model and historical indicators")]
    P1("1.0  Capture and diagnose: Single image or six grid cells; Plant gate > crop gate > disease model")
    P2("2.0  Manage scan history: Browse / search / filter / reopen; Retag or delete saved records")
    P3("3.0  Analyze and forecast: Home outlook; report dashboard; Monthly logged-detection estimates")
    P4("4.0  Provide crop guidance: Treatment and disease prevention; Qualitative seasonal risk rules")
    P5("5.0  Export scouting report: Match location-tagged saved scans; Create localized Papusoy PDF report")
    P6("6.0  Manage preferences: English / Tagalog language; Add / rename / remove location choices")
    P7("7.0  Back up and restore: Validate ZIP manifest / JSON / images; Replace rows and restore image files")
    end
